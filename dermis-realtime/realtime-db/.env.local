# Generic / backend
SPACETIMEDB_DB_NAME=dermis-realtime-db
SPACETIMEDB_HOST=https://maincloud.spacetimedb.com

# Vite
VITE_SPACETIMEDB_DB_NAME=dermis-realtime-db
# Leave VITE_SPACETIMEDB_HOST unset for a LAN demo. The viewer derives the
# WebSocket hostname from the URL used to open it (for example, the Mac's LAN IP).

# Next.js
NEXT_PUBLIC_SPACETIMEDB_DB_NAME=dermis-realtime-db
NEXT_PUBLIC_SPACETIMEDB_HOST=https://maincloud.spacetimedb.com

# Create React App
REACT_APP_SPACETIMEDB_DB_NAME=dermis-realtime-db
REACT_APP_SPACETIMEDB_HOST=https://maincloud.spacetimedb.com

# Expo
EXPO_PUBLIC_SPACETIMEDB_DB_NAME=dermis-realtime-db
EXPO_PUBLIC_SPACETIMEDB_HOST=https://maincloud.spacetimedb.com

# SvelteKit
PUBLIC_SPACETIMEDB_DB_NAME=dermis-realtime-db
PUBLIC_SPACETIMEDB_HOST=https://maincloud.spacetimedb.com
