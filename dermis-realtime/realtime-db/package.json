{
  "name": "realtime-db",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "format": "prettier . --write --ignore-path ../../.prettierignore",
    "lint": "eslint . && prettier . --check --ignore-path ../../.prettierignore",
    "preview": "vite preview",
    "test": "vitest run",
    "generate": "npm run spacetime:generate",
    "spacetime:generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path spacetimedb && prettier --write src/module_bindings",
    "spacetime:publish:local": "spacetime publish dermis-realtime-db --module-path spacetimedb --server local --yes",
    "spacetime:publish": "spacetime publish --module-path spacetimedb --server maincloud",
    "publisher": "tsx tools/test-publisher.ts",
    "publisher:cup-trace": "tsx tools/cup-trace-publisher.ts",
    "room:cup": "tsx tools/cup-room-host.ts",
    "room:assist": "tsx tools/assist-room-host.ts",
    "assist:request": "tsx tools/request-assistive-grasp.ts",
    "cup:request": "tsx tools/request-cup-trial.ts",
    "bridge:stdin": "tsx tools/python-stdin-bridge.ts",
    "worker": "tsx tools/task-worker.ts",
    "worker:cup": "tsx tools/cup-challenge-worker.ts",
    "worker:assist": "tsx tools/assist-challenge-worker.ts",
    "test:integration": "tsx tools/integration-test.ts"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.186.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "spacetimedb": "2.13.*",
    "three": "^0.186.1",
    "undici": "^6.29.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^7.1.5",
    "vitest": "3.2.4"
  }
}
