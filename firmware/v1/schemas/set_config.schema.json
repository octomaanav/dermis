{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dermis:wire:1.0:set_config",
  "title": "Dermis SET_CONFIG payload (wire schema v1.0)",
  "description": "Payload of command 0x83. Only these keys are writable. \"pods\" replaces the whole pod list; \"mag\" and \"imu\" entries are matched by \"ch\" and merged. The device applies all of it or none of it, only while stopped, then bumps config_id and sends a fresh DEVICE_INFO.",
  "type": "object",
  "minProperties": 1,
  "additionalProperties": false,
  "properties": {
    "rate_hz": {
      "type": "number",
      "minimum": 0,
      "maximum": 2000
    },
    "role": {
      "enum": [
        "glove",
        "robot",
        "bench"
      ]
    },
    "hand": {
      "enum": [
        "left",
        "right",
        "none"
      ]
    },
    "pods": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/pod"
      }
    },
    "mag": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ch"
        ],
        "additionalProperties": false,
        "minProperties": 2,
        "properties": {
          "ch": {
            "type": "integer",
            "minimum": 0,
            "maximum": 31
          },
          "gain_sel": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "hallconf": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "res_xyz": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "minItems": 3,
            "maxItems": 3
          },
          "osr": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "osr2": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "dig_filt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "mount": {
            "$ref": "#/$defs/mount"
          }
        }
      }
    },
    "imu": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ch"
        ],
        "additionalProperties": false,
        "minProperties": 2,
        "properties": {
          "ch": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "acc_range_g": {
            "enum": [
              2,
              4,
              8,
              16
            ]
          },
          "acc_odr_hz": {
            "enum": [
              25,
              50,
              100,
              200,
              400,
              800,
              1600
            ]
          },
          "gyr_range_dps": {
            "enum": [
              125,
              250,
              500,
              1000,
              2000
            ]
          },
          "gyr_odr_hz": {
            "enum": [
              25,
              50,
              100,
              200,
              400,
              800,
              1600,
              3200
            ]
          },
          "mount": {
            "$ref": "#/$defs/mount"
          }
        }
      }
    }
  },
  "$defs": {
    "location": {
      "enum": [
        "thumb_tip",
        "index_tip",
        "middle_tip",
        "ring_tip",
        "little_tip",
        "thenar_apb",
        "hypothenar",
        "palm_center",
        "hand_dorsum",
        "wrist",
        "bench",
        "unassigned"
      ]
    },
    "mount": {
      "type": "string",
      "pattern": "^(?=.*X)(?=.*Y)(?=.*Z)[+-][XYZ][+-][XYZ][+-][XYZ]$",
      "description": "Which signed chip axis points along the pod's distal, lateral and normal axes, in that order, e.g. \"+X+Y+Z\" or \"-Y+X+Z\". Must describe a rotation (no reflection)."
    },
    "pod": {
      "type": "object",
      "required": [
        "id",
        "location",
        "mag_ch",
        "imu_ch"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 32,
          "description": "Physical pod serial, \"\" if not assigned yet."
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "mag_ch": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 31
        },
        "imu_ch": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 15
        }
      }
    }
  }
}
