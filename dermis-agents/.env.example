# Copy to .env. Nothing here is required for a local run.

# SpacetimeDB (Manav's module). Empty SPACETIME_DB = local dataset only.
SPACETIME_HOST=https://maincloud.spacetimedb.com
SPACETIME_DB=
SPACETIME_TOKEN=
SPACETIME_EPISODE_TABLE=episode
SPACETIME_FRAME_TABLE=frame

# Local fallback dataset (defaults to ../dermis-teleop/dataset/dermis_sim_v1)
# DERMIS_DATA_DIR=

# ASI:One LLM (https://asi1.ai, API keys in the developer dashboard). Without it, rule-based parsing.
ASI1_API_KEY=
ASI1_MODEL=asi1-mini

# Agent identity. Same secret = same 12 addresses on every machine. Keep it private.
# If empty, a random one is created in .agent_seed on first run.
AGENT_SEED_SECRET=

# Agentverse API key (agentverse.ai → profile → API Keys), used by connect.py to connect all mailboxes
AGENTVERSE_API_KEY=

# 1 = reachable from Agentverse / ASI:One through mailboxes
DERMIS_MAILBOX=0
DERMIS_PORT=8000

# 0 = no QuickChart image links in replies
DERMIS_CHARTS=1
