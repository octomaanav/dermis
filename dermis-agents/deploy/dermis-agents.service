[Unit]
Description=Dermis Fetch.ai agents (hub + 13 specialists, Agentverse mailbox)
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__DIR__
Environment=DERMIS_MAILBOX=1
Environment=PYTHONUNBUFFERED=1
ExecStart=__DIR__/.venv/bin/python run.py
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=40

[Install]
WantedBy=multi-user.target
